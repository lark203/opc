# 【生产】环境变量

# 页面标题
VITE_APP_TITLE = 量子科技

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（生产环境设置为实际后端地址）
VITE_API_URL = /prod-api

# 生产服务器端口
VITE_PORT = 80

# Delete console
VITE_DROP_CONSOLE = true

# 客户端id
VITE_APP_CLIENT_ID = e5cd7e4891bf95d1d19206ce24a7b32e

# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_ENCRYPT = true

# RSA 加密公钥（对应后端的 privateKey）
VITE_APP_RSA_PUBLIC_KEY = 

# RSA 解密私钥（敏感，禁止提交真实值；通过本地 .env 或 CI 注入。注：私钥置于前端本质上无法保密，建议复核后端→前端响应加密设计）
VITE_APP_RSA_PRIVATE_KEY = <SET_VIA_ENV_OR_CI>

# 权限控制模式：frontend（前端控制）或 backend（后端控制）
VITE_ACCESS_MODE = backend

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 应用基础URL（用于拼接头像等资源路径）
VITE_APP_BASE_URL = /

# 路由信息开关（是否在页面底部显示路由信息）
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥（敏感，请勿提交真实值；通过本地 .env 或 CI 注入）
VITE_LOCK_ENCRYPT_KEY = <SET_VIA_ENV_OR_CI>

# 统一消息推送开关
VITE_APP_MESSAGE_ENABLED = true

# sse / websocket
VITE_APP_MESSAGE_TRANSPORT = 'sse'

# 统一消息推送路径
VITE_APP_MESSAGE_PATH = '/resource/message'

# Spring Boot Admin 监控台地址（Admin监控页面内嵌该地址）
VITE_APP_MONITOR_ADMIN = '/admin/applications'

# SnailJob 控制台地址（任务调度中心页面内嵌该地址）
VITE_APP_SNAILJOB_ADMIN = '/snail-job'

# SnailAI 控制台地址（AI控制台页面内嵌该地址）
VITE_APP_SNAILAI_ADMIN = '/snail-ai'
