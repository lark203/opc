# 【模板】环境变量（复制为 .env / .env.development / .env.production 后填入真实值，不要提交带真实值的文件）
# 说明：VITE_ 前缀变量会在构建时打包进前端产物（对客户端可见），因此即便不提交到仓库，
#       私钥等敏感值也仅能提供“混淆”作用，无法真正保密。请务必：
#       1. 通过本地 .env（已被 .gitignore 忽略）或 CI 变量注入真实值；
#       2. 一旦私钥曾提交/打包，应视为已泄露并重新生成密钥对（见下方说明）。

# 版本号
VITE_VERSION = 3.0.2

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = frontend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 页面标题
VITE_APP_TITLE = 量子科技

# API 请求基础路径（开发 /dev-api，生产 /prod-api，或实际后端地址）
VITE_API_URL = /dev-api

# 代理目标地址（仅开发用，RuoYi-Vue-Plus 后端地址）
VITE_API_PROXY_URL = http://localhost:8080

# Delete console
VITE_DROP_CONSOLE = false

# 客户端id（非机密，可公开）
VITE_APP_CLIENT_ID = e5cd7e4891bf95d1d19206ce24a7b32e

# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_ENCRYPT = true

# RSA 加密公钥（对应后端的 privateKey）—— 公钥可公开，保留即可
VITE_APP_RSA_PUBLIC_KEY = 

# RSA 解密私钥（敏感！不要填写真实值到本文件；通过本地 .env 或 CI 注入）
# ⚠️ 前端不该持有私钥：该私钥用于解密后端响应，但前端产物中任何人都能提取，
#    因此该方案不提供真正机密性。建议复核后端→前端响应加密设计，必要时移除客户端解密。
VITE_APP_RSA_PRIVATE_KEY = <SET_VIA_ENV_OR_CI>

# 应用基础URL（用于拼接头像等资源路径）
VITE_APP_BASE_URL = http://localhost:5173

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 锁屏加密密钥（敏感！不要填写真实值到本文件；通过本地 .env 或 CI 注入）
VITE_LOCK_ENCRYPT_KEY = <SET_VIA_ENV_OR_CI>

# 统一消息推送开关
VITE_APP_MESSAGE_ENABLED = true

# sse / websocket
VITE_APP_MESSAGE_TRANSPORT = 'sse'

# 统一消息推送路径
VITE_APP_MESSAGE_PATH = '/resource/message'

# Spring Boot Admin 监控台地址（Admin监控页面内嵌该地址）
VITE_APP_MONITOR_ADMIN = 'http://localhost:9090/admin/applications'

# SnailJob 控制台地址（任务调度中心页面内嵌该地址）
VITE_APP_SNAILJOB_ADMIN = 'http://localhost:8800/snail-job'

# SnailAI 控制台地址（AI控制台页面内嵌该地址）
VITE_APP_SNAILAI_ADMIN = 'http://localhost:8900/snail-ai'
