# 【开发】环境变量

# 页面标题
VITE_APP_TITLE = 量子科技

# 应用部署基础路径
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理）
VITE_API_URL = /dev-api

# 代理目标地址（RuoYi-Vue-Plus 后端地址）
VITE_API_PROXY_URL = http://localhost:8080

# 开发服务器端口
VITE_PORT = 5173

# Delete console
VITE_DROP_CONSOLE = false

# 客户端id
VITE_APP_CLIENT_ID = e5cd7e4891bf95d1d19206ce24a7b32e

# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_ENCRYPT = true

# RSA 加密公钥（对应后端的 privateKey）
VITE_APP_RSA_PUBLIC_KEY = MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDvEDuRIOM3oZPWj9Ukoc5pQklR4PFH6/clnjeFqjDLIgDyQvjxhgqAZQA+E9eD6qu6FsXPmK8djcL+nh3cFHz4pX473jDvO3Sve+8yL3VRQ0n2pRgQ2a01MJsy+WwTZCBYWf0VnLRIvANUoWQgy9vz94q7Va44dg7A1/3ICf+xAwIDAQAB

# RSA 解密私钥（对应后端的 publicKey）
VITE_APP_RSA_PRIVATE_KEY = 

# 权限控制模式：frontend（前端控制）或 backend（后端控制）
VITE_ACCESS_MODE = backend

# 应用基础URL（用于拼接头像等资源路径）
VITE_APP_BASE_URL = http://localhost:5173

# 路由信息开关（是否在页面底部显示路由信息）
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = art-design-pro-lock-key

# 统一消息推送开关
VITE_APP_MESSAGE_ENABLED = true

# sse / websocket
VITE_APP_MESSAGE_TRANSPORT = 'sse'

# 统一消息推送路径
VITE_APP_MESSAGE_PATH = '/resource/message'

# Spring Boot Admin 监控台地址（Admin监控页面内嵌该地址）
VITE_APP_MONITOR_ADMIN = 'http://localhost:9090/admin/applications'

# SnailJob 控制台地址（任务调度中心页面内嵌该地址）
VITE_APP_SNAILJOB_ADMIN = 'http://localhost:8800/snail-job'

# SnailAI 控制台地址（AI控制台页面内嵌该地址）
VITE_APP_SNAILAI_ADMIN = 'http://localhost:8900/snail-ai'